# Copia in .env.local (sviluppo) o imposta nelle variabili d'ambiente del provider (Vercel).
# Nessuna di queste e' obbligatoria per far girare il sito pubblico: senza, tracking e
# pannello si disattivano e il form contatti continua a funzionare.

# PostgreSQL (Neon, Vercel Postgres, Supabase, locale...). Con Neon usa l'URL "pooled".
# SSL: rispettato ?sslmode=... nell'URL; senza, e' "require" per host non locali.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Percorso segreto del pannello admin, senza slash: 8-64 caratteri [A-Za-z0-9_-],
# non puo' iniziare con api, admin, it, en, _next, _vercel.
# Il pannello e' su https://<dominio>/<ADMIN_PATH>. Se assente, il pannello e' irraggiungibile.
# Genera un valore: node -e "console.log('c-'+require('crypto').randomBytes(9).toString('base64url'))"
ADMIN_PATH=

# Segreto per GET /api/cron/purge (header Authorization: Bearer <CRON_SECRET>), min 16 caratteri.
# Su Vercel, Vercel Cron lo invia automaticamente se la variabile e' impostata.
CRON_SECRET=

# Resend: notifiche email del form contatti.
RESEND_API_KEY=
